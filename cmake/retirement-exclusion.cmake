# RT-1: prove a replacement links without its registry-listed C implementations.
# This changes compilation only, never supplies replacement symbols or linker flags.
include_guard(GLOBAL)
set(TSFP_RETIRE_EXCLUDE_UNITS "" CACHE STRING
    "Semicolon-separated repository-relative C units excluded for retirement proof")

function(tsfp_retirement_targets directory output)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    tsfp_retirement_targets("${child}" nested)
    list(APPEND targets ${nested})
  endforeach()
  set(${output} "${targets}" PARENT_SCOPE)
endfunction()

function(tsfp_retirement_exclude)
  if(NOT TSFP_RETIRE_EXCLUDE_UNITS)
    return()
  endif()
  file(REAL_PATH "${CMAKE_SOURCE_DIR}" root)
  set(excluded)
  foreach(unit IN LISTS TSFP_RETIRE_EXCLUDE_UNITS)
    if(IS_ABSOLUTE "${unit}" OR NOT unit MATCHES "\\.c$" OR unit MATCHES "\\$<")
      message(FATAL_ERROR "Retirement exclusion requires a repository-relative .c unit: ${unit}")
    endif()
    if(NOT EXISTS "${root}/${unit}" OR IS_DIRECTORY "${root}/${unit}")
      message(FATAL_ERROR "Retirement exclusion unit does not exist: ${unit}")
    endif()
    file(REAL_PATH "${root}/${unit}" canonical)
    string(FIND "${canonical}" "${root}/" inside)
    if(NOT inside EQUAL 0)
      message(FATAL_ERROR "Retirement exclusion unit is outside repository: ${unit}")
    endif()
    list(APPEND excluded "${canonical}")
  endforeach()
  list(REMOVE_DUPLICATES excluded)
  set(unmatched "${excluded}")
  tsfp_retirement_targets("${CMAKE_SOURCE_DIR}" targets)
  foreach(target IN LISTS targets)
    foreach(property SOURCES INTERFACE_SOURCES)
    get_target_property(sources "${target}" "${property}")
    if(NOT sources)
      continue()
    endif()
    get_target_property(source_dir "${target}" SOURCE_DIR)
    set(kept)
    set(changed FALSE)
    foreach(source IN LISTS sources)
      if(source MATCHES "\\$<")
        # TARGET_OBJECTS references stay: their owning target is processed separately.
        # Refuse conditional C inputs we cannot safely rewrite rather than fake proof.
        if(NOT source MATCHES "^\\$<TARGET_OBJECTS:[^>]+>$")
          message(FATAL_ERROR "Retirement exclusion cannot rewrite generator-expression source: ${source}")
        endif()
        list(APPEND kept "${source}")
        continue()
      endif()
      file(REAL_PATH "${source}" canonical BASE_DIRECTORY "${source_dir}")
      if(canonical IN_LIST excluded)
        list(REMOVE_ITEM unmatched "${canonical}")
        set(changed TRUE)
        message(STATUS "Retirement exclusion: ${target}: ${source}")
      else()
        list(APPEND kept "${source}")
      endif()
    endforeach()
    if(changed)
      get_target_property(kind "${target}" TYPE)
      if(NOT kept AND property STREQUAL "SOURCES" AND
          NOT kind STREQUAL "INTERFACE_LIBRARY" AND NOT kind STREQUAL "UTILITY")
        # CMake rejects source-less OBJECT/static targets. A typedef produces no
        # replacement symbol; an unresolved caller must still fail at link time.
        set(empty "${CMAKE_BINARY_DIR}/retirement-exclusion-empty.c")
        file(WRITE "${empty}" "/* No retirement replacement symbols. */\ntypedef char tsfp_retirement_empty_translation_unit;\n")
        list(APPEND kept "${empty}")
      endif()
      set_property(TARGET "${target}" PROPERTY "${property}" "${kept}")
    endif()
    endforeach()
  endforeach()
  if(unmatched)
    message(FATAL_ERROR "Retirement exclusion units were not found in target sources: ${unmatched}")
  endif()
endfunction()

# All target_sources/add_subdirectory calls must have completed before filtering.
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL tsfp_retirement_exclude)
