include("${CMAKE_CURRENT_LIST_DIR}/rust-host-rpath.cmake")
# T2056: -DTSFP_RUST_FILEIO=ON links crates/tsfp-fileio-capi (the Rust disc reader of tsfp-engine-fileio) into
# tsfp_host (as libtsfp_fileio_capi.so). Most operations select Rust at runtime;
# T2225 verified slices require it in the selected kernel object even when runtime selection is OFF.
# The common archive remains the full C oracle. Rust-main inherits the host sources and libraries.
tsfp_fileio_capi()
set(fileio_target_dir "${CMAKE_BINARY_DIR}/rust-fileio")
if(TSFP_NATIVE_FILEIO)
  set(fileio_target_dir "${CMAKE_BINARY_DIR}/rust-fileio-native")
endif()
set(fileio_archive "${fileio_target_dir}/release/libtsfp_fileio_capi.so")
add_dependencies(tsfp_host tsfp_rust_fileio_archive)
target_link_libraries(tsfp_host PRIVATE "${fileio_archive}")
set_target_properties(tsfp_host PROPERTIES ENABLE_EXPORTS ON)
tsfp_rust_host_rpath(tsfp_host "${fileio_target_dir}/release")

if(TSFP_RUST_FILEIO OR TSFP_RUST_FILEIO_TESTS)
  if(TSFP_RUST_FILEIO)
    target_compile_definitions(tsfp_host PRIVATE TSFP_RUST_FILEIO=1)
    target_compile_definitions(tsfp_host_options PUBLIC TSFP_RUST_FILEIO=1)
    set_source_files_properties(src/host/rust_fileio.c PROPERTIES COMPILE_DEFINITIONS TSFP_RUST_FILEIO=1)
  endif()
endif()

