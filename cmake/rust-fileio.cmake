# T2225: the same host-free suites against the selected kernel object.
# Oracle executables above retain the common archive for independent A/B evidence.
if(TSFP_RUST_FILEIO)
  set(selected_suites t2225_hostio_diff t2225_lifecycle_diff t2225_rename_diff
    t2225_resolution_diff t2225_names_diff t2225_dircursor_diff t2074_hostio_diff
    test_kernel_file_rust_hostio test_hdd_backing_rust_hostio
    t2210_test_kernel_async_io_rust t2210_test_kernel_io_rust
    t2210_test_kernel_file_object_rust t2210_test_hdd_backing_rust
    t2210_test_kernel_delete_rename_rust test_kernel_file)
  foreach(suite IN LISTS selected_suites)
    # Retirement exclusion builds remove the C-only oracle targets. Keep the
    # Rust-selected copies of the remaining suites, but do not query properties
    # from a target that the exclusion projection intentionally removed.
    if(NOT TARGET ${suite})
      continue()
    endif()
    get_target_property(suite_sources ${suite} SOURCES)
    add_executable(${suite}_selected ${suite_sources})
    target_include_directories(${suite}_selected PRIVATE
      $<TARGET_PROPERTY:${suite},INCLUDE_DIRECTORIES>)
    target_compile_definitions(${suite}_selected PRIVATE
      $<TARGET_PROPERTY:${suite},COMPILE_DEFINITIONS>)
    target_link_libraries(${suite}_selected PRIVATE
      $<TARGET_PROPERTY:${suite},LINK_LIBRARIES> tsfp_xbox "${fileio_archive}")
    add_dependencies(${suite}_selected tsfp_rust_fileio_archive)
    tsfp_rust_host_rpath(${suite}_selected "${fileio_target_dir}/release")
    add_test(NAME ${suite}_selected COMMAND ${suite}_selected)
    if(suite MATCHES "^t2210_")
      set_tests_properties(${suite}_selected PROPERTIES ENVIRONMENT "T2210_COMPOSE_FILEIO=1")
    endif()
    if(suite MATCHES "hdd_backing|dircursor")
      tsfp_hdd_scratch(${suite}_selected)
    endif()
  endforeach()
endif()
